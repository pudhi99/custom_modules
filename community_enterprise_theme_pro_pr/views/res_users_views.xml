<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add fields to the user preferences form -->
    <record id="res_users_view_form_preferences" model="ir.ui.view">
        <field name="name">res.users.view.form.preferences.theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="color_scheme" widget="radio" options="{'horizontal': true}"/>
                <field name="dark_mode_theme" widget="radio" options="{'horizontal': true}"
                       invisible="color_scheme == 'light'"/>
            </xpath>
        </field>
    </record>

    <!-- Also add them to the main Users form (for administrators) -->
    <record id="res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.view.form.theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="color_scheme" widget="radio" options="{'horizontal': true}"/>
                <field name="dark_mode_theme" widget="radio" options="{'horizontal': true}"
                       invisible="color_scheme == 'light'"/>
            </xpath>
        </field>
    </record>
</odoo>
