<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban dashboard: traffic-light grouped by expiry_status -->
    <record id="view_expiry_dashboard_kanban" model="ir.ui.view">
        <field name="name">stock.lot.expiry.kanban</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <kanban default_group_by="expiry_status"
                    class="o_kanban_dashboard"
                    group_create="false"
                    quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="expiry_status"/>
                <field name="days_to_expiry"/>
                <field name="expiration_date"/>
                <field name="product_qty"/>
                <field name="estimated_cost"/>
                <field name="last_alert_date"/>
                <field name="alert_count"/>
                <progressbar field="expiry_status"
                             colors='{"green": "success", "yellow": "warning", "red": "danger", "expired": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary fw-bold">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_secondary text-muted">
                                        <field name="product_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <t t-if="record.expiry_status.raw_value == 'expired'">
                                        <span class="badge bg-secondary">EXPIRED</span>
                                    </t>
                                    <t t-elif="record.expiry_status.raw_value == 'red'">
                                        <span class="badge bg-danger">CRITICAL</span>
                                    </t>
                                    <t t-elif="record.expiry_status.raw_value == 'yellow'">
                                        <span class="badge bg-warning text-dark">WARNING</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-success">SAFE</span>
                                    </t>
                                </div>
                            </div>
                            <div class="o_kanban_card_content mt-1">
                                <div class="row">
                                    <div class="col-6">
                                        <span class="text-muted small">Days Left</span><br/>
                                        <strong class="text-danger">
                                            <field name="days_to_expiry"/>
                                        </strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted small">Qty on Hand</span><br/>
                                        <strong><field name="product_qty"/></strong>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col-12">
                                        <span class="text-muted small">Expires</span>
                                        <field name="expiration_date" widget="date"/>
                                    </div>
                                </div>
                                <div class="row mt-1">
                                    <div class="col-12">
                                        <span class="text-muted small">Cost at Risk</span>
                                        <strong class="text-danger">
                                            <field name="estimated_cost" widget="monetary"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_footer">
                                <span class="text-muted small">Alerts: <field name="alert_count"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard action -->
    <record id="action_expiry_dashboard" model="ir.actions.act_window">
        <field name="name">Expiry Dashboard</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('expiration_date', '!=', False)]</field>
        <field name="context">{'group_by': 'expiry_status'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_expiry_dashboard_kanban')})]"/>
    </record>

    <!-- List action for expiring lots -->
    <record id="action_expiry_lot_list" model="ir.actions.act_window">
        <field name="name">Expiring Lots</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('expiration_date', '!=', False)]</field>
    </record>
</odoo>
