<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expiry_export_form" model="ir.ui.view">
        <field name="name">stock.expiry.export.form</field>
        <field name="model">stock.expiry.export</field>
        <field name="arch" type="xml">
            <form string="Export Expiry Report">
                <sheet>
                    <group>
                        <group string="Export Options">
                            <field name="export_format"/>
                            <field name="status_filter"/>
                        </group>
                        <group string="Date Range (optional)">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Download" invisible="not export_file">
                        <field name="export_file" widget="binary" filename="export_filename"/>
                        <field name="export_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export" type="object"
                            string="Export" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_expiry_export" model="ir.actions.act_window">
        <field name="name">Export Expiry Report</field>
        <field name="res_model">stock.expiry.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
