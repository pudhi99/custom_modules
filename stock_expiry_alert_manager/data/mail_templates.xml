          <t t-esc="object.expiration_date.strftime('%d %b %Y') if object.expiration_date else 'N/A'"/>
        </td>
      </tr>
      <tr>
        <td style="padding:10px;font-weight:bold;border:1px solid #c8e6c9;">Days Remaining</td>
        <td style="padding:10px;border:1px solid #c8e6c9;color:#28a745;font-weight:bold;">
          <t t-esc="object.days_to_expiry"/> days
