        <field name="name">Expiry Alert — Level 1 (30 days)</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="subject">⚠️ Expiry Notice (30 days): {{ object.product_id.display_name }} — Lot {{ object.name }}</field>
        <field name="email_from">{{ (user.email_formatted or user.company_id.email or 'noreply@example.com') }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;border:1px solid #ddd;border-radius:8px;overflow:hidden;">
  <div style="background:#28a745;padding:20px;text-align:center;">
    <h1 style="color:white;margin:0;font-size:22px;">📦 Expiry Alert — 30 Days</h1>
  </div>
  <div style="padding:24px;background:#f9f9f9;">
    <p>Dear <strong><t t-esc="ctx['recipient_user'].name if ctx.get('recipient_user') else 'Team'"/></strong>,</p>
    <p>The following lot will expire in approximately <strong>30 days</strong>. Please plan accordingly.</p>
    <table style="width:100%;border-collapse:collapse;margin:16px 0;">
      <tr style="background:#e8f5e9;">
        <td style="padding:10px;font-weight:bold;border:1px solid #c8e6c9;width:40%;">Product</td>
        <td style="padding:10px;border:1px solid #c8e6c9;"><t t-esc="object.product_id.display_name"/></td>
      </tr>
      <tr>
        <td style="padding:10px;font-weight:bold;border:1px solid #c8e6c9;">Lot / Serial No.</td>
        <td style="padding:10px;border:1px solid #c8e6c9;"><t t-esc="object.name"/></td>
      </tr>
      <tr style="background:#e8f5e9;">
        <td style="padding:10px;font-weight:bold;border:1px solid #c8e6c9;">Expiry Date</td>
