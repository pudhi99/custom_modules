          <td style="padding:12px;text-align:center;border-bottom:1px solid #ddd;font-size:20px;font-weight:bold;color:#dc3545;">
            <t t-esc="len(red_lots)"/>
          </td>
          <td style="padding:12px;text-align:right;border-bottom:1px solid #ddd;font-size:12px;color:#dc3545;">Immediate clearance</td>
