            <t t-esc="len(yellow_lots)"/>
          </td>
          <td style="padding:12px;text-align:right;border-bottom:1px solid #ddd;font-size:12px;color:#856404;">Plan consumption</td>
        </tr>
        <tr style="background:#d4edda;">
          <td style="padding:12px;font-weight:bold;color:#155724;border-bottom:1px solid #ddd;">🟢 SAFE (GREEN)</td>
