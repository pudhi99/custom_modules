        <td style="padding:10px;border:1px solid #c8e6c9;"><t t-esc="object.product_qty"/></td>
      </tr>
      <tr>
        <td style="padding:10px;font-weight:bold;border:1px solid #c8e6c9;">Estimated Cost at Risk</td>
        <td style="padding:10px;border:1px solid #c8e6c9;">
          <t t-esc="object.estimated_cost"/>
