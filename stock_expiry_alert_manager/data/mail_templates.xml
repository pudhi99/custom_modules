  <div style="padding:24px;background:#f8f9fa;">
    <p>Dear <strong><t t-esc="ctx['recipient_user'].name if ctx.get('recipient_user') else 'Team'"/></strong>,</p>
    <p>Here is your weekly expiry stock summary for <strong><t t-esc="object.name"/></strong>:</p>

    <t t-set="expired_lots" t-value="ctx.get('lots_by_status', {}).get('expired') or []"/>
    <t t-set="red_lots"     t-value="ctx.get('lots_by_status', {}).get('red') or []"/>
    <t t-set="yellow_lots"  t-value="ctx.get('lots_by_status', {}).get('yellow') or []"/>
    <t t-set="green_lots"   t-value="ctx.get('lots_by_status', {}).get('green') or []"/>

    <table style="width:100%;border-collapse:collapse;margin:16px 0;">
      <thead>
