          <td style="padding:12px;text-align:right;border-bottom:1px solid #ddd;font-size:12px;color:#155724;">Monitor</td>
        </tr>
      </tbody>
    </table>

    <div style="background:#e9ecef;border-radius:4px;padding:12px;margin-top:16px;">
      <p style="margin:0;color:#6c757d;font-size:13px;">
        Log in to <strong>Odoo → Inventory → Expiry Alerts → Dashboard</strong> to review full details and process transfers.
      </p>
