      </tr>
      <tr style="background:#e8f5e9;">
        <td style="padding:10px;font-weight:bold;border:1px solid #c8e6c9;">Company</td>
        <td style="padding:10px;border:1px solid #c8e6c9;"><t t-esc="object.company_id.name"/></td>
      </tr>
    </table>
    <p style="color:#555;">Action: Begin planning to consume, promote, or discount this stock within 30 days.</p>
