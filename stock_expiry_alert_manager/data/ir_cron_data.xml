<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- CRON 1: Compute expiry status + auto clearance transfers (daily 07:00) -->
    <record id="cron_compute_expiry_status" model="ir.cron">
        <field name="name">Stock Expiry: Compute Status &amp; Auto Transfers</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="state">code</field>
        <field name="code">model._cron_compute_expiry_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=7, minute=0, second=0, microsecond=0)"/>
        <field name="priority">5</field>
    </record>

    <!-- CRON 2: Send daily tiered email alerts (daily 08:00) -->
    <record id="cron_send_daily_alerts" model="ir.cron">
        <field name="name">Stock Expiry: Send Daily Alerts</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=8, minute=0, second=0, microsecond=0)"/>
        <field name="priority">10</field>
    </record>

    <!-- CRON 3: Weekly digest (every Monday 08:00) -->
    <record id="cron_send_weekly_digest" model="ir.cron">
        <field name="name">Stock Expiry: Weekly Digest</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_weekly_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=7)).replace(hour=8, minute=0, second=0, microsecond=0)"/>
        <field name="priority">15</field>
    </record>

</odoo>
