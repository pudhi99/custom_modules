<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report action -->
    <record id="action_report_expiry_lots" model="ir.actions.report">
        <field name="name">Expiry Report</field>
        <field name="model">stock.lot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_expiry_alert_manager.report_expiry_lots</field>
        <field name="report_file">stock_expiry_alert_manager.report_expiry_lots</field>
        <field name="print_report_name">'Expiry_Report_%s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb PDF template -->
    <template id="report_expiry_lots">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="lot">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div style="background: #2c3e50; color: white; padding: 20px; border-radius: 6px; margin-bottom: 20px;">
                            <h2 style="margin: 0; font-size: 20px;">Product Expiry Report</h2>
                            <p style="margin: 4px 0 0; opacity: 0.8;">
                                Generated: <t t-esc="datetime.datetime.now().strftime('%d %b %Y %H:%M')"/>
                            </p>
                        </div>

                        <!-- Status badge -->
                        <t t-set="status_color" t-value="'#28a745' if lot.expiry_status == 'green' else '#ffc107' if lot.expiry_status == 'yellow' else '#dc3545'"/>
                        <div t-att-style="'background: %s; color: white; padding: 10px 16px; border-radius: 4px; display: inline-block; margin-bottom: 16px;' % status_color">
                            <strong>
                                <t t-esc="(lot.expiry_status or 'N/A').upper()"/>
                                — <t t-esc="lot.days_to_expiry"/> days remaining
                            </strong>
                        </div>

                        <!-- Lot details table -->
                        <table class="table table-bordered" style="width: 100%; margin-bottom: 20px;">
                            <thead>
                                <tr style="background: #f8f9fa;">
                                    <th style="width: 35%;">Field</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Lot / Serial Number</strong></td>
                                    <td><t t-esc="lot.name"/></td>
                                </tr>
                                <tr style="background: #f8f9fa;">
                                    <td><strong>Product</strong></td>
                                    <td><t t-esc="lot.product_id.display_name"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Expiration Date</strong></td>
                                    <td>
                                        <t t-if="lot.expiration_date">
                                            <t t-esc="lot.expiration_date.strftime('%d %b %Y')"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr style="background: #f8f9fa;">
                                    <td><strong>Days to Expiry</strong></td>
                                    <td><t t-esc="lot.days_to_expiry"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Qty on Hand</strong></td>
                                    <td><t t-esc="lot.product_qty"/> <t t-esc="lot.product_uom_id.name"/></td>
                                </tr>
                                <tr style="background: #f8f9fa;">
                                    <td><strong>Estimated Cost at Risk</strong></td>
                                    <td>
                                        <t t-esc="lot.env.company.currency_id.symbol"/>
                                        <t t-esc="'%.2f' % lot.estimated_cost"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Alerts Sent</strong></td>
                                    <td><t t-esc="lot.alert_count"/></td>
                                </tr>
                                <tr style="background: #f8f9fa;">
                                    <td><strong>Last Alert</strong></td>
                                    <td>
                                        <t t-if="lot.last_alert_date">
                                            <t t-esc="lot.last_alert_date.strftime('%d %b %Y %H:%M')"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Auto Transfer Created</strong></td>
                                    <td><t t-esc="'Yes' if lot.auto_transfer_created else 'No'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Alert history -->
                        <t t-if="lot.expiry_history_ids">
                            <h4>Alert History</h4>
                            <table class="table table-bordered table-sm" style="width: 100%;">
                                <thead>
                                    <tr style="background: #343a40; color: white;">
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Level</th>
                                        <th>Status</th>
                                        <th>Days</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="lot.expiry_history_ids" t-as="hist">
                                        <tr>
                                            <td><t t-esc="hist.alert_date and hist.alert_date.strftime('%d %b %Y') or '—'"/></td>
                                            <td><t t-esc="hist.alert_type or '—'"/></td>
                                            <td><t t-esc="hist.alert_level or '—'"/></td>
                                            <td><t t-esc="(hist.expiry_status or '—').upper()"/></td>
                                            <td><t t-esc="hist.days_to_expiry"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Page break between lots -->
                        <t t-if="not lot_last">
                            <div style="page-break-after: always;"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
