<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        HomeMenu Template — Full-screen app grid with search bar.

        Icon rendering logic (from computeAppsAndMenuItems in menu_helpers.js):
        - If app.webIconData exists → render <img> (base64 or URL path)
        - Else if app.webIcon exists → render colored div with FA icon
        - Else → default icon fallback
    -->

    <t t-name="beautiful_web_theme_pr.HomeMenu">
        <div class="o_home_menu" t-ref="root" t-att-style="backgroundImageStyle">

            <!-- Hidden input to capture keystrokes and trigger the Command Palette (Enterprise style) -->
            <input
                type="text"
                class="o_search_hidden visually-hidden w-auto"
                data-allow-hotkeys="true"
                t-ref="searchInput"
                t-on-input="onSearchInput"
                t-on-blur="onSearchBlur"
                t-on-compositionstart="onCompositionStart"
                role="combobox"
                aria-autocomplete="list"
                aria-haspopup="listbox"
            />

            <div class="o_home_menu_scrollable">

                <!-- App Grid -->
                <div t-if="displayedApps.length" class="o_apps">
                    <t t-foreach="displayedApps" t-as="app" t-key="app.id">
                        <a class="o_app"
                           t-att-href="app.href"
                           t-on-click.prevent="(ev) => this.onAppClicked(app)">
                            <div class="o_app_icon_container">
                                <img t-if="app.webIconData"
                                     t-att-src="app.webIconData"
                                     class="o_app_icon"
                                     loading="lazy"
                                     t-att-alt="app.label"/>
                                <div t-elif="app.webIcon"
                                     class="o_app_icon_default"
                                     t-attf-style="background-color: {{app.webIcon.backgroundColor}}">
                                    <i t-att-class="app.webIcon.iconClass"
                                       t-attf-style="color: {{app.webIcon.color}}"/>
                                </div>
                                <div t-else=""
                                     class="o_app_icon_default"
                                     style="background-color: #875A7B;">
                                    <i class="fa fa-th-large" style="color: #ffffff;"/>
                                </div>
                            </div>
                            <div class="o_app_name" t-esc="app.label"/>
                        </a>
                    </t>
                </div>

            </div>
        </div>
    </t>

</templates>
